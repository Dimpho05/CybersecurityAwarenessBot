<Window x:Class="CybersecurityAwarenessBotGUI.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Quiz" Height="600" Width="750"
        Background="#0D0D1A" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="[ CYBERSECURITY QUIZ ]" FontFamily="Consolas"
                       FontSize="18" FontWeight="Bold" Foreground="#00FFFF"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Test your cybersecurity knowledge!" FontFamily="Consolas"
                       FontSize="11" Foreground="#555577" HorizontalAlignment="Center"/>
            <Rectangle Height="1" Fill="#00FFFF" Margin="0,8,0,0" Opacity="0.4"/>
        </StackPanel>

        <!-- SCORE AND PROGRESS -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ScoreText" Grid.Column="0"
                       Text="Score: 0" FontFamily="Consolas" FontSize="13"
                       Foreground="#00FF99" HorizontalAlignment="Left"/>
            <TextBlock x:Name="ProgressText" Grid.Column="1"
                       Text="Question 1 of 12" FontFamily="Consolas" FontSize="13"
                       Foreground="#00FFFF" HorizontalAlignment="Right"/>
        </Grid>

        <!-- QUESTION -->
        <Border Grid.Row="2" Background="#0A0A14" BorderBrush="#1A1A3E"
                BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <TextBlock x:Name="QuestionText" FontFamily="Consolas" FontSize="14"
                       Foreground="White" TextWrapping="Wrap" LineHeight="22"/>
        </Border>

        <!-- ANSWER OPTIONS -->
        <StackPanel x:Name="AnswerPanel" Grid.Row="3" Margin="0,0,0,15">
            <RadioButton x:Name="OptionA" GroupName="Answers" Margin="0,8,0,0"
                         Foreground="White" FontFamily="Consolas" FontSize="13"
                         Checked="Option_Checked"/>
            <RadioButton x:Name="OptionB" GroupName="Answers" Margin="0,8,0,0"
                         Foreground="White" FontFamily="Consolas" FontSize="13"
                         Checked="Option_Checked"/>
            <RadioButton x:Name="OptionC" GroupName="Answers" Margin="0,8,0,0"
                         Foreground="White" FontFamily="Consolas" FontSize="13"
                         Checked="Option_Checked"/>
            <RadioButton x:Name="OptionD" GroupName="Answers" Margin="0,8,0,0"
                         Foreground="White" FontFamily="Consolas" FontSize="13"
                         Checked="Option_Checked"/>
        </StackPanel>

        <!-- FEEDBACK -->
        <Border x:Name="FeedbackBorder" Grid.Row="4" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,15" Visibility="Collapsed">
            <TextBlock x:Name="FeedbackText" FontFamily="Consolas" FontSize="13"
                       TextWrapping="Wrap" FontWeight="Bold"/>
        </Border>

        <!-- NEXT BUTTON -->
        <Button x:Name="NextButton" Grid.Row="5" Content="NEXT QUESTION ▶"
                Click="Next_Click" IsEnabled="False"
                Background="#00FFFF" Foreground="#0D0D1A"
                FontFamily="Consolas" FontWeight="Bold" FontSize="13"
                BorderThickness="0" Padding="0,10" Cursor="Hand"/>
    </Grid>
</Window>